<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.weartak.plugin.permission.BIND_PLUGIN"
        android:protectionLevel="signature" />
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <queries>
        <package android:name="com.aitech.weartak_civ" />
        <package android:name="com.aitech.weartak_civ.dev" />
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@drawable/mopp_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mopp">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity android:name=".MoppActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".host.MoppPluginService"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="com.weartak.plugin.action.PLUGIN_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.weartak.plugin.MENU_SUBTITLE"
                android:value="@string/plugin_subtitle" />
        </service>
    </application>
</manifest>
